{
  "name": "iso-guardian-ai-agent",
  "version": "1.0.0",
  "description": "ISO-Guardian AI 에이전트 - LRQA의 교육적 지원을 위한 AI 채팅봇",
  "main": "frontend/index.html",
  "scripts": {
    "start": "netlify dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "echo 'Frontend build completed'",
    "build:backend": "echo 'Backend build completed'",
    "dev": "netlify dev",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "jest frontend/js/__tests__/",
    "test:backend": "python -m pytest backend/python/tests/",
    "test:integration": "jest tests/integration/",
    "test:e2e": "playwright test",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint frontend/js/ --ext .js",
    "lint:backend": "flake8 backend/python/",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "prettier --write frontend/js/",
    "format:backend": "black backend/python/",
    "deploy": "netlify deploy --prod",
    "deploy:preview": "netlify deploy",
    "logs": "netlify logs",
    "status": "netlify status",
    "setup": "npm install && pip install -r requirements.txt",
    "clean": "rm -rf node_modules dist logs",
    "health": "curl http://localhost:8888/.netlify/functions/health"
  },
  "keywords": [
    "iso",
    "certification",
    "ai",
    "chatbot",
    "lrqa",
    "quality-management",
    "environmental-management",
    "safety-management"
  ],
  "author": "LRQA Korea <dal.kim@lrqa.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrqa/iso-guardian-ai-agent.git"
  },
  "bugs": {
    "url": "https://github.com/lrqa/iso-guardian-ai-agent/issues"
  },
  "homepage": "https://iso-guardian.netlify.app",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "netlify-cli": "^15.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "frontend/js/**/*.js",
      "!frontend/js/__tests__/**",
      "!frontend/js/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
