# ISO-Guardian AI 에이전트 환경 변수 설정

# Python 설정
PYTHON_PATH=python
PYTHON_VERSION=3.9

# AI 모델 설정
AI_MODEL=gpt-3.5-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_TIMEOUT=30000

# LRQA 설정
LRQA_BASE_URL=https://www.lrqa.com/kr
LRQA_API_KEY=your_lrqa_api_key

# 데이터베이스 설정
DATABASE_URL=sqlite:///data/iso_guardian.db
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30

# 로깅 설정
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# 보안 설정
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=https://iso-guardian.netlify.app,https://www.lrqa.com

# 성능 설정
CACHE_TTL=3600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# 개발 설정
NODE_ENV=development
DEBUG=true
HOT_RELOAD=true

# 프로덕션 설정
# NODE_ENV=production
# DEBUG=false
# HOT_RELOAD=false
