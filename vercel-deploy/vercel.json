{
  "version": 2,
  "functions": {
    "api/create-quotation.js": {
      "maxDuration": 60
    },
    "api/download-quotation.js": {
      "maxDuration": 60
    },
    "api/send-email.js": {
      "maxDuration": 30
    },
    "api/submit-application.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "./adj_quote_engine"
  }
}
